rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety net catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    // ID validation helper
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Schema Validation Helpers to protect the database from resource poisoning
    function isValidMenuItem(data) {
      return data.keys().hasAll(['id', 'name', 'price', 'category']) 
        && data.keys().size() <= 8
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.price is number && data.price > 0
        && (data.category == 'Food' || data.category == 'Drinks')
        && (!data.keys().hasAny(['popular']) || data.popular is bool)
        && (!data.keys().hasAny(['isVegetarian']) || data.isVegetarian is bool)
        && (!data.keys().hasAny(['imageEmoji']) || (data.imageEmoji is string && data.imageEmoji.size() <= 1000));
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'tableNumber', 'items', 'totalPrice', 'timestamp', 'status'])
        && data.keys().size() <= 8
        && data.id is string && data.id.size() <= 128
        && data.tableNumber is string && data.tableNumber.size() <= 10
        && data.items is list && data.items.size() > 0 && data.items.size() <= 50
        && data.totalPrice is number && data.totalPrice >= 0
        && data.timestamp is string && data.timestamp.size() <= 40
        && (data.status == 'Pending' || data.status == 'Preparing' || data.status == 'Served' || data.status == 'Completed')
        && (!data.keys().hasAny(['note']) || (data.note is string && data.note.size() <= 1000));
    }

    // Menu list rule mappings
    match /menu_items/{menuItemId} {
      allow read: if true;
      allow create: if isValidId(menuItemId) && isValidMenuItem(incoming());
      allow update: if isValidId(menuItemId) && isValidMenuItem(incoming());
      allow delete: if true;
    }

    // Table orders rule mappings
    match /orders/{orderId} {
      allow read: if true;
      allow create: if isValidId(orderId) && isValidOrder(incoming());
      allow update: if isValidId(orderId) && isValidOrder(incoming());
      allow delete: if true;
    }
  }
}
